<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ecommerce</title>
    <!-- CSS-link -->
    <link rel="stylesheet" href="/css/home/style.css">
    <link rel="stylesheet" href="/css/home/popup.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@100;200;300;400;500;600;700&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css"
        integrity="sha512-MV7K8+y+gLIBoVD59lQIYicR65iaqukzvf/nwasF0nqhPay5w/9lJmVM2hMDcnK1OnMGCdVK+iQrJ7lzPJQd1w=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel="stylesheet" href="https://unpkg.com/boxicons@latest/css/boxicons.min.css">
    <link rel="stylesheet" href="css/todosProdutos/busca.css">
    <link rel="stylesheet" href="/css/painel/style.css">
    <link rel="stylesheet" href="/css/todosProdutos/footer.css">
   


    <link rel="shortcut icon" href="/img/home/carrinho-de-compras.png" type="image/x-icon">

</head>

<body>
    <input type="hidden" id="nomeEmpresa" value="<%= empresa %>">

    <% if (idSessao === empresaId) { %>
        <header class="painel-administrativo">
            <div class="logo">
              <!--  <img src="/logo/<%#= empresa %>" alt="Logo da Loja"> -->
            </div>
            
            <nav>
                <ul class="opcoes">
                    <% if (empresa == "administrador") { %>
                        <li class="opcao"><a class="link" href="/admin/usuarios">Usuarios</a></li>
                   <% } %>
                    <li class="opcao"><a class="link" href="/<%= empresa %>">Loja</a></li>
                    <li class="opcao"><a class="link" href="/admin/produtos">Produtos</a></li>
                    <li class="opcao"><a class="link" href="/admin/configuracoes">Configurações</a></li>
                    <li class="opcao"><a class="link" href="/deslogar/<%= empresa %>">Sair </a></li>
                </ul>
            </nav>
            
        </header>
    <% } %>
    
       
        <%- include('./partials/navbar.ejs') %>
        <%- include('abaCarrinho') %>

    <!-- seção de produtos  -->

   
    <div id="popup" class="popup" style="display:none;">
        Produto adicionado ao carrinho!
      </div>
    
            <!-- seção de produtos  -->
            <section class="trending-product" id="trending">
                <div class="center-text">

                    <br>
                    <form action="/pesquisar" method="post">
                    <input type="text" id="searchInput"  placeholder="Digite o nome do produto para buscar" name="pesquisa" autofocus>
                    <input type="hidden" name="empresaId" value="<%= empresaId %>"> 
                    <input type="hidden" name="empresa" value="<%= empresa %>"> 
                    <input type="hidden" name="instagram" value="<%= instagram %>"> 
                    <input type="hidden" name="numero" value="<%= numero %>"> 
                    <input type="hidden" name="tema" value="<%= tema %>"> 

                    <br>
                    <button type="submit" id="btn-pesquisar">Pesquisar</button>
                    </form>
                    <ul id="searchResults"></ul>
                    <br>
                    <h2>Todas os <span>Produtos </span></h2>
                    

                    <%#  function limitarTamanhoString(str, limite) { %>
                        <%#   if (str.length > limite) { %>
                        <%#       return str.slice(0, limite) + "..."; %>
                         <%#  } else { %>
                         <%#     return str %>
                         <%#  } %>
                    <%#   } %>
                    
                </div>
                 <div class="filtered-products"></div>
                <div class="products">

                    <% if (produtos.length == 0 && pesquisa == undefined) { %>
                        <div class="container">
                            <h2>Nenhum produto achado</h2>
                            <p>desculpe, mas nenhum produto foi encontrado para a pesquisa "<%= pesquisa %>", porfavor tente pesquisar algo diferente</p>
                        </div>
                    <% } else { %>
                        <% produtos.forEach(produto => { %>
                                        
                        
                            <div class="row"  >
                                <a class="a_detalhes" href="/<%= empresa %>/detalhes/<%= produto.id_produto %>/<%= produto.slug %>"><div class="box_img" id="box_img"><img src="/imagem/<%= produto.id_produto %>" id="imgProduto" class="img_antes"><!-- <img src="/imagem2/<%#= produto.id_produto %>" id="imgProduto" class="img_depois"> --></div></a> 
                                <div class="product-text">
                                   <!--<h5>Oferta</h5>--> 
                                </div>

                                

                                    <% if (produto.status == 'indisponivel') { %>
                                        <div class="price">
 
                                       <!-- <h4> <%#= limitarTamanhoString(produto.nome_produto, 15) %></h4>-->
                                        <h4 class="nome_produto"> <%= produto.nome_produto %></h4> 
 
                                        <p style="color: red;">indisponivel</p>
                                        </div>


                                    <% } else { %>
                                        <div class="heart-icon"> <i class='bx bx-cart' id="<%= produto.id_produto %> " onclick="adicionar('<%= produto.id_produto %>', '<%= produto.preco %>', '<%= produto.nome_produto %>', '<%= empresa%>')" id="<%= produto.id_produto %>"  ></i>
                                        </div>
                                     
                                        <div class="price">
                                          <!-- <h4> <%#= limitarTamanhoString(produto.nome_produto, 30) %></h4>--> 
                                            <h4 class="nome_produto"> <%= produto.nome_produto %></h4>

                                            <p> <% if (produto.preco == '') { %>
                                                <%= produto.preco %>
                                            <% } else { %>
                                                <% if (taxas.taxas.avista.taxa == true) { %>
                                                    <strong class="preco_estilo">R$<%= (produto.preco - (taxas.taxas.avista.valor * produto.preco /100)).toFixed(2).replace('.', ',')  %></strong>  
                                                    
                                                    <% if (taxas.taxas.credito.taxa === "true") { %>
                                                        <% let opc_credito = [] %>
                                                        <% for( let opc in taxas.taxas.credito.valores ) { %>
                                                            <% if (taxas.taxas.credito.valores[opc][0]) { %>
                                                               <% opc_credito.push(opc) %>
                                                            <% } %>
                                                           
                                                        <% } %>
                                                         <% if (opc_credito.length === 0 ) { %>
                                                            à vista no pix ou cartão de debito
                                                        <% } else { %>
                                                            <% var maioresOpcoes = opc_credito.sort((a, b) => parseFloat(b) - parseFloat(a)); %>
                                                            <% var maiorOpcao = maioresOpcoes[0]; %>
                                                            <% var semX = ''%>
                                                            <% for( let c in maiorOpcao) { %>
                                                                <% if (maiorOpcao[c] !== 'x') { %>
                                                                    <% semX += maiorOpcao[c] %>
                                                                <% } %>
                                                            <% } %>
                                                            <% var maiorNum = parseFloat(semX) %>
                                                            <% var taxaDaMaiorOpcao = taxas.taxas.credito.valores[maiorOpcao][1]; %>

                                                            <% var jurusMaior = ((((parseFloat(taxaDaMaiorOpcao) * produto.preco) / 100) + parseFloat(produto.preco)) / maiorNum).toFixed(2)  %>
                                                           
                                                            à vista ou em até <%= maiorNum%>x de R$<%= jurusMaior.replace('.', ",") %> no cartão com jurus 
                                                        <% } %>
                                                        


                                                    <% } else {%>
                                                        à vista no pix ou cartão de debito
                                                        <%= taxas.taxas.credito.valores[0] %>
                                                        <%= taxas.taxas.avista.valor %>
                                                    <% } %>



                                                <% } else {%>
                                               <strong class="preco_estilo">R$<%= produto.preco %></strong> à vista ou em até
                                               10x de R$xxx no cartão sem juros 
                                               <% } %>
                                            <% } %>
                                            </p>
                                        </div>
                                    <% } %>
                                
                            </div>
                                    
                        <% }) %>
                    <% } %>
               

                <!-- Elemento HTML para exibir os produtos filtrados -->
               

                </div>
            </div>

                
                </div>


            </section>

    

    <!-- seção-avaliação-clientes -->


    <!-- seção-de-contato -->
    <%- include('./partials/footer.ejs') %>

    <script>
    //document.addEventListener('DOMContentLoaded', function() {

        var tema = '<%= tema %>'
        //console.log(tema);
        var body = document.querySelector('body');

            if(tema == "Roxo") {
                document.documentElement.style.setProperty('--color-green', '#8800a7');
                body.style.setProperty('--color-green', '#8800a7')

            } else if (tema == "Vermelho"){
                document.documentElement.style.setProperty('--color-green', '#ff0000');
                body.style.setProperty('--color-green', '#ff0000')

            } else if (tema == "Verde"){
                document.documentElement.style.setProperty('--color-green', '#3fca04');
                body.style.setProperty('--color-green', '#3fca04')
            } else if (tema == "Azul"){
                document.documentElement.style.setProperty('--color-green', '#00acfc');
                body.style.setProperty('--color-green', '#00acfc')

            } else if (tema == "Amarelo"){
                document.documentElement.style.setProperty('--color-green', '#eaff00');
                body.style.setProperty('--color-green', '#eaff00')

            } else if (tema == "Laranja"){
                document.documentElement.style.setProperty('--color-green', '#e19406');
                body.style.setProperty('--color-green', '#e19406')
            
            }

           /* var logo_empresa = document.getElementById("Produtos-btn")
            logo_empresa.style.display = 'none'
            */

 

  


</script>

    <script src="/js/home/script.js"></script>
    <script src="https://kit.fontawesome.com/998c60ef77.js" crossorigin="anonymous"></script>
    <script src="/js/home/ajax.js"></script>
    <script src="/js/abaCarrinho/script.js"></script>
    <script src="/js/home/mudaCor.js"></script>

   
</body>

</html>