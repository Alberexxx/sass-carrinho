<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Personalize sua Página</title>
    <link rel="stylesheet" href="/css/painel/style.css">

    <style>
        .container {
            font-family: Arial, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
        }
        form {
            display: flex;
            flex-direction: column;
            width: 300px;
        }
        label {
            margin-top: 10px;
        }
        select, input {
            margin-top: 5px;
            padding: 8px;
            width: 100%;
            box-sizing: border-box;
        }
        .logo {
            margin-top: 20px;
            max-width: 150px;
            max-height: 90px;
            height: auto;
        }
    </style> 
</head>
<body>
     
    <header class="painel-administrativo" >
        <div class="logo">
            <img src="/logo/<%= usuario.nome %>" alt="Logo da Loja" style="margin-top: -20px;" >
        </div>
        <nav>
            <ul class="opcoes">
                <% if (empresa == "administrador") { %>
                    <li class="opcao"><a class="link" href="/admin/usuarios">Usuarios</a></li>
               <% } %>
                <li class="opcao"><a class="link" href="/<%= usuario.nome %>">Loja</a></li>
                <li class="opcao"><a class="link" href="/admin/produtos">Produtos</a></li>
                <li class="opcao"><a class="link" href="/admin/configuracoes">Configurações</a></li>
                <li class="opcao"><a class="link" href="/deslogar/<%= empresa %>">Sair</a></li>
            </ul>
        </nav>
    </header>
    
    <container class="container" style="margin-top: -80px;">
    <form enctype="multipart/form-data" method="post" action="/admin/configuracoes/edit">
        <label for="corTema">Escolha o tema da página:</label>
        <select id="corTema" name="tema">
            <option value="Padrão" <% if (usuario.corTema === 'Padrão') { %> selected <% } %>>Padrão</option>
            <option value="Azul" <% if (usuario.corTema === 'Azul') { %> selected <% } %>>Azul</option>
            <option value="Roxo" <% if (usuario.corTema === 'Roxo') { %> selected <% } %>>Roxo</option>
            <option value="Vermelho" <% if (usuario.corTema === 'Vermelho') { %> selected <% } %>>Vermelho</option>
            <option value="Verde" <% if (usuario.corTema === 'Verde') { %> selected <% } %>>Verde</option>
            <option value="Amarelo" <% if (usuario.corTema === 'Amarelo') { %> selected <% } %>>Amarelo</option>
            <option value="Laranja" <% if (usuario.corTema === 'Laranja') { %> selected <% } %>>Laranja</option>
        </select>
        <label for="numeroWhatsapp">Número do WhatsApp:</label>
        <input type="text" id="numeroWhatsapp" placeholder=" ex: 81993856910" name="numero" value="<%= usuario.telefone %>">
        <label for="linkInstagram">Link da página do Instagram:</label>
        <input type="text" id="linkInstagram" placeholder="https://instagram.com/meuUsuario?igshid=MzdddhbsU2YQ==" name="instagram" value="<%= usuario.instagram %>">
        <label for="logo">Envie uma nova logo:</label>
        <input type="file" id="logo" name="logo">
        <input type="submit" value="Editar">
    </form>
   </container>
</body>
</html>
