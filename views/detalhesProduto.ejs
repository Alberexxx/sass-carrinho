              btn.style.backgroundColor = '#3fca04'

          } else if (tema == "Azul"){
              document.documentElement.style.setProperty('--color-green', '#00acfc');
              body.style.setProperty('--color-green', '#00acfc')
              btn.style.backgroundColor = '#00acfc'
          } else if (tema == "Amarelo"){
              document.documentElement.style.setProperty('--color-green', '#c8da00');
