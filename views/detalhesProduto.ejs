    <script>
     
      var tema = '<%= tema %>'
      var body = document.querySelector('body');
      var btn = document.getElementById('button')

          if(tema == "Roxo") {
              document.documentElement.style.setProperty('--color-green', '#8800a7');
              body.style.setProperty('--color-green', '#8800a7')
              btn.style.backgroundColor = '#8800a7'

          } else if (tema == "Vermelho"){
              document.documentElement.style.setProperty('--color-green', '#ff0000');
              body.style.setProperty('--color-green', '#ff0000')
              btn.style.backgroundColor = '#ff0000'

          } else if (tema == "Verde"){
              document.documentElement.style.setProperty('--color-green', '#3fca04');
              body.style.setProperty('--color-green', '#3fca04')
              btn.style.backgroundColor = '#3fca04'

          } else if (tema == "Azul"){
              document.documentElement.style.setProperty('--color-green', '#00acfc');
              body.style.setProperty('--color-green', '#00acfc')
              btn.style.backgroundColor = '#00acfc'
          } else if (tema == "Amarelo"){
              document.documentElement.style.setProperty('--color-green', '#eaff00');
              body.style.setProperty('--color-green', '#eaff00')
              btn.style.backgroundColor = '#eaff00'

          } else if (tema == "Laranja"){
              document.documentElement.style.setProperty('--color-green', '#e19406');
              body.style.setProperty('--color-green', '#e19406')
              btn.style.backgroundColor = '#e19406'

          }

function substituirImagem() {

  var elementoImagem1 = document.getElementById('mini1');
  var elementoImagem2 = document.getElementById('mini2');

  elementoImagem1.style.display = 'none'; 
  elementoImagem2.style.display = 'none'; 

}
    let currentIndex = 0;
    var imagemExibida = document.getElementById('imagemExibida')
    var imagemContainer = document.getElementById('imagemContainer')
    var foto1 = document.getElementById('foto1').value;
    var foto2 = document.getElementById('foto2').value;
    
    
    var mini1 = document.getElementById("mini1");
    var mini2 = document.getElementById('mini2');

    mini1.addEventListener('click', function () { showImage(foto1)})
    mini2.addEventListener('click', function () { showImage(foto2)})

    let startX;
    
    // Exibe a imagem inicial
   // showImage(currentIndex);
   showImage(foto1);

    // Evento de toque inicial
    imagemContainer.addEventListener('touchstart', function (e) {
      startX = e.touches[0].clientX;
    });

    // Evento de deslize
    imagemContainer.addEventListener('touchmove', function (e) {
      const currentX = e.touches[0].clientX;
      const diffX = startX - currentX;

      // Define um limiar para considerar como um deslize
      const swipeThreshold = 50;

      if (Math.abs(diffX) > swipeThreshold) {
        if (diffX > 0) {
          // Deslizou para a esquerda
          showImage(foto2);
        } else {
          // Deslizou para a direita'
          showImage(foto1);
        }

        startX = currentX
      }
    }); 

    function showImage(url) {
      imagemExibida.src = url;
    }
      
    </script>

   
