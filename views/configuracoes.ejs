<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Personalize sua Página</title>
    <link rel="stylesheet" href="/css/painel/style.css">
    <link rel="stylesheet" href="/css/configuracoes/configuracoes.css">
    <style>
       
    </style> 
</head>
<body>
     
    <header class="painel-administrativo" >
        <div class="logo">
            <img src="/logo/<%= usuario.nome %>" alt="Logo da Loja" style="margin-top: -20px;" >
        </div>
        <nav>
            <ul class="opcoes">
                <% if (empresa == "administrador") { %>
                    <li class="opcao"><a class="link" href="/admin/usuarios">Usuarios</a></li>
               <% } %>
                <li class="opcao"><a class="link" href="/<%= usuario.nome %>">Loja</a></li>
                <li class="opcao"><a class="link" href="/admin/produtos">Produtos</a></li>
                <li class="opcao"><a class="link" href="/admin/configuracoes">Configurações</a></li>
                <li class="opcao"><a class="link" href="/deslogar/<%= empresa %>">Sair</a></li>
            </ul>
        </nav>
    </header> 
    <br><br><br><br>
    
    <container class="container" >
    <form enctype="multipart/form-data" method="post" action="/admin/configuracoes/edit" id="meuForm">
        <label for="corTema">Escolha o tema da página:</label>
        <select id="corTema" name="tema">
            <option value="Padrão" <% if (usuario.corTema === 'Padrão') { %> selected <% } %>>Padrão</option>
            <option value="Azul" <% if (usuario.corTema === 'Azul') { %> selected <% } %>>Azul</option>
            <option value="Roxo" <% if (usuario.corTema === 'Roxo') { %> selected <% } %>>Roxo</option>
            <option value="Vermelho" <% if (usuario.corTema === 'Vermelho') { %> selected <% } %>>Vermelho</option>
            <option value="Verde" <% if (usuario.corTema === 'Verde') { %> selected <% } %>>Verde</option>
            <option value="Amarelo" <% if (usuario.corTema === 'Amarelo') { %> selected <% } %>>Amarelo</option>
            <option value="Laranja" <% if (usuario.corTema === 'Laranja') { %> selected <% } %>>Laranja</option>
        </select>
        <label for="numeroWhatsapp">Número do WhatsApp para envio do carrinho:</label>
        <input type="text" id="numeroWhatsapp" placeholder=" ex: 81993856910" name="numero" value="<%= usuario.telefone %>">
       
        <label >Contato no rodapé da pagina:</label>
        <input type="text" id="contato" placeholder="" name="contato" value="<%= usuario.contato %>" >

        <label for="pagamento">taxas de pagamento:</label>
        <div style="display: flex;">
        
            <button type="button" class="btn-pagamento" id="btn-avista" >a vista/pix</button>
            <button type="button" class="btn-pagamento" id="btn-credito">credito</button>
            <button type="button" class="btn-pagamento" id="btn-debito">debito</button>
            <button type="button" class="btn-pagamento" onclick="criarJSON()">montar json</button>

        </div>
        <div id="avista_container" >
            <div id="opc_avista_container"> 
                    <p class="label-p">aplicar desconto para compras a vista/pix?</p>
                
                <label for="opc1">
                    <input class="opc" type="radio" name="opc" id="opc1" checked value="false">
                    Não
                </label>
                <label for="opc2">
                    <input class="opc" type="radio" name="opc" id="opc2" value="true">
                    Sim
                </label>
            </div>
            <div id="taxa_avista">
                <br>
                <label for="avistaTaxa">digite o porcentagem do desconto:</label>
                <input type="number" name="avistaTaxa" id="avistaTaxa" step="0.1" placeholder="ex: 9,5%">
                <br><br>
            </div>
        
        </div>
        
        <div class="credito_container" id="credito_container">
            <div id="opc_credito_container"> 
                <p class="label-p">sua loja cobra taxas em compras com cartão de credito?</p>
            <label for="opc2">
                <input class="opc" type="radio" name="opc_crd" id="opc2_crd" value="true" > 
                Sim
            </label>
            <label for="opc1">
                <input class="opc" type="radio" name="opc_crd" id="opc1_crd" value="false">
                Não
            </label> 
            </div> 

            <div id="taxa_credito">
                <p>selecione e preencha as taxas de credito que sua loja trabalha: </p>

                <input class="opc" type="checkbox" name="1x_crd" >1x
                <input type="number" name="cTaxa1" class="inp_crd" step="0.1" placeholder="ex: 9,5">
                <input class="opc" type="checkbox" name="2x_crd"  >2x
                <input type="number" name="Ctaxa2" class="inp_crd" step="0.1" placeholder="ex: 1,5">
                <br>
                <input class="opc" type="checkbox" name="3x_crd" >3x
                <input type="number" name="cTaxa3" class="inp_crd" step="0.1" placeholder="ex: 9,9">
                <input class="opc" type="checkbox" name="4x_crd" >4x
                <input type="number" name="cTaxa4" class="inp_crd" step="0.1" placeholder="ex: 9,5">
                <br>
                <input class="opc" type="checkbox" name="5x_crd"  >5x
                <input type="number" name="cTaxa5" class="inp_crd" step="0.1" placeholder="ex: 2,5">
                <input class="opc" type="checkbox" name="6x_crd"  >6x
                <input type="number" name="cTaxa6" class="inp_crd" step="0.1" placeholder="ex: 9,5">
                <br>
                <input class="opc" type="checkbox" name="7x_crd"  >7x
                <input type="number" name="cTaxa7" class="inp_crd" step="0.1" placeholder="ex: 0">
                <input class="opc" type="checkbox" name="8x_crd"  >8x
                <input type="number" name="cTaxa8" class="inp_crd" step="0.1" placeholder="ex: 8,5">
                <br>
                <input class="opc" type="checkbox" name="9x_crd"  >9x
                <input type="number" name="cTaxa9" class="inp_crd" step="0.1" placeholder="ex: 9,1">
                <input class="opc" type="checkbox" name="10x_crd" >10x
                <input type="number" name="cTaxa10" class="inp_crd" step="0.1" placeholder="ex: 0,5">
                <br>
                <input class="opc" type="checkbox" name="11x_crd"  >11x
                <input type="number" name="cTaxa11" class="inp_crd" step="0.1" placeholder="ex: 1,1">
                <input class="opc" type="checkbox" name="12x_crd" >12x
                <input type="number" name="cTaxa12" class="inp_crd" step="0.1" placeholder="ex: 4,2">

                
            </div>
        </div>

        <div class="debito_container" id="debito_container">
            <div id="opc_debito_container"> 
                <p class="label-p">sua loja cobra taxas em compras com cartão de debito?</p>
            <label for="opc2">
                <input class="opc" type="radio" name="opc_deb" id="opc2_deb" value="true" > 
                Sim
            </label>
            <label for="opc1">
                <input class="opc" type="radio" name="opc_deb" id="opc1_deb" value="false" checked>
                Não
            </label> 
            
            </div>

            <div id="taxa_debito">
                <p>Digite a porcentagem de desconto: </p>
            
                <input type="number" id="dTaxa" class="" step="0.1" placeholder="ex: 1,25">
                
            </div>
        </div>

        <label for="horario">horario de funcionamento:</label>
        <input type="text" id="horario" placeholder=" ex: funcionamos das 8:00h às 16:00h" name="horario" value="<%= usuario.horario %>">

        <label for="endereco">Endereço:</label>
        <input type="text" id="endereco" placeholder=" ex: Rua das flores nº159" name="endereco" value="<%= usuario.enderecoLoja  %>">

        <label for="linkInstagram">Link da página do Instagram:</label>
        <input type="text" id="linkInstagram" placeholder="https://instagram.com/meuUsuario?igshid=MzdddhbsU2YQ==" name="instagram" value="<%= usuario.instagram %>">
       
        <label for="logo">Envie uma nova logo:</label>
        <input type="file" id="logo" name="logo">
       
        <input type="submit" id="inp_submit" value="Salvar Edições">
        <br><br>
        
    </form>
   </container>
   <script src="/js/configuracoes/configuracoes.js"></script> 
 
</body>
</html>
