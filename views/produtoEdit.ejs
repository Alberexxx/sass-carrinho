</head>

<body>
    <header class="painel-administrativo">
        
    
        <nav>
            <ul class="opcoes">
                <% if (empresa == "administrador") { %>
                    <li class="opcao"><a class="link" href="/admin/usuarios">Usuarios</a></li>
               <% } %>
                <li class="opcao"><a class="link" href="/<%= empresa %>">Loja</a></li>
                <li class="opcao"><a class="link" href="/admin/produtos">Produtos</a></li>
                <li class="opcao"><a class="link" href="/admin/configuracoes">Configurações</a></li>
                <li class="opcao"><a class="link" href="/deslogar/<%= empresa %>">Sair </a></li>
            </ul>
        </nav>
        
    </header>


    <div class="signup-body">
        <div class="container">
            <div class="login-box">
                <div class="login-header">
                    <h2>Editar Produto</h2>
                    <p>edite as informações abaixo! </p>
                </div>
                    <div class="div-form">
                        <div class="div1">
                            <div class="div-form">
                                <div class="div1" id="tamanho">
                                    <div class="input-container tamanho">
                                        <label>Foto 1 do Produto</label>

                                        <br>
                                    <form action="/admin/produto/edit/env" method="post" enctype="multipart/form-data">
                                        <label for="foto">
                                            <img id="fotoproduto" style=" max-width: 170px; max-height: 170px; " src="/imagem/<%= produto.id_produto %>" alt="" />
                                        </label>
                                        <label class="borda-arredondada input" for="foto">Selecionar foto 1
                                            <img src="https://cdn3.iconfinder.com/data/icons/glypho-generic-icons/64/action-upload-alt-512.png"
                                                style="width: 20px" />
                                        </label>
                                        <input type="file" accept="image/*" name="foto" id="foto" style="opacity: 0;">
                                        <div class="input-container tamanho">
                                            
                                            <label>Foto 2 do Produto  </label>
                                                <br>
                                                <% if (produto.foto2 === null || produto.foto2 === undefined) { %>
                                                    <img id="previewImage2" src="/img/public/transferir.png" style=" max-width: 170px; max-height: 170px; " >
                                                    
                                                    <img class="x_btn" id="limpar_2" src="/img/public/bx-x.svg" alt="" onclick="limpar()">
                                                    <input type="hidden" name="foto2_existe" id="foto2_existe" value="false">

                                                <% } else { %>
                                                    <img id="previewImage2" src="/imagem2/<%= produto.id_produto %>" style=" max-width: 170px; max-height: 170px;" >
                                                   
                                                    <img class="x_btn" id="limpar_2" style="display: inline;" src="/img/public/bx-x.svg" alt="" onclick="limpar()">
                                                    <input type="hidden" name="foto2_existe" id="foto2_existe" value="true">
                                                <% } %>

                                          
                                                
                                            </label>
                                            <label class="borda-arredondada input" for="foto2"
                                                style="color: rgb(2, 2, 2);">Selecionar foto 2 *opcional
                                                <img src="https://cdn3.iconfinder.com/data/icons/glypho-generic-icons/64/action-upload-alt-512.png"
                                                    style="width: 20px" />
                                            </label>
                                            <input type="file" accept="image/*" name="foto2" id="foto2" style="opacity: 0;" >
                                        </div>
                         <!--           </div> 
                            
                                    <div class="input-container tamanho">
                                        <label for="tamanho">Tamanho</label>

                                        <select id="select-tamanho" name="tamanho">

                                        <%# if (produto.tamanho === "") { %>
                                            <option value="" selected> </option>

                                        <%# } else {%>
                                            <option value=""></option>
                                        <%# } %>
                                        <%# if (produto.tamanho === "P") { %>
                                            <option value="P" selected>P</option>

                                        <%# } else {%>
                                            <option value="P">P</option>
                                        <%# } %>
                                        <%# if (produto.tamanho === "M") { %>
                                            <option value="M" selected>M</option>

                                         <%# } else {%>
                                            <option value="M">M</option>

                                         <%# } %>
                                         <%# if (produto.tamanho === "G") { %>
                                            <option value="G" selected>G</option>

                                         <%# } else {%>
                                            <option value="G">G</option>

                                         <%# } %>
                                         <%# if (produto.tamanho === "GG") { %>
                                            <option value="GG" selected>GG</option>

                                         <%# } else {%>
                                            <option value="GG">GG</option>

                                         <%# } %>

                                            

                                        </select>
                                        

                                    </div>
                                    <div class="input-container tamanho">
                                        <div class="modelo">
                                            <label id="modelolabel">Modelo: </label>

                                            <%# if (produto.modelo === "masculino") { %>
                                                 <label class="modelo-option" for="m">
                                                <input type="radio" name="modelo" id="m" value="masculino" checked>
                                                Masculino
                                            </label>
                                            <label class="modelo-option" for="f">
                                                <input type="radio" name="modelo" id="f" value="feminino"  > 
                                                   Feminino                     
                                                </label>
                                            <%#} else {%>
                                                <label class="modelo-option" for="m">
                                                    <input type="radio" name="modelo" id="m" value="masculino" >
                                                    Masculino
                                                </label>
                                                <label class="modelo-option" for="f">
                                                <input type="radio" name="modelo" id="f" value="feminino"  checked> 
                                                    Feminino                     
                                                </label>
                                            <%#}%>

                                            
                                           
                                           
                                        </div>
                                        -->
                                    </div>
                                    
                                </div>
                                <div class="div1">
                                    <div class="input-container">
                                        <label for="nome">Nome</label>
                                        <input type="text" name="nome" id="nome" required maxlength="60" placeholder="Nome do Produto" value="<%= produto.nome_produto %>" required>
                                    </div>
                                    <div class="input-container">
                                        <label for="categoria">Marca</label>
                                        <input type="text" name="marca" id="marca"
                                            placeholder="Digite a marca" value="<%= produto.marca %>"  maxlength="100">
                                    </div>
                                    <div class="input-container">
                                        <label for="descricao">descrição</label>
                                        <input type="text" name="descricao" id="" placeholder="digite uma descricao para o produto" value="<%= produto.descricao %>" maxlength="950">
                                        
                                    </div>
                                    <div class="input-container">
                                        <label for="categoria">Categoria</label>
                                        <input type="text" name="categoria" id="categoria"
                                            placeholder="Digite a Categoria"  value="<%= produto.nome_categoria %>" maxlength="50">

                                            <input type="hidden" name="id" value="<%= produto.id_produto %>">
                                    </div>
                                    <div class="input-container">
                                        <label for="valor">Valor</label>
                                        <input type="text"  id="valor" name="preco" step="0.01"
                                       
                                        placeholder="Digite o Valor"  value="R$<%= produto.preco %>"   oninput="formatarInput(this)">
                                    </div>
                                    <div class="input-container tamanho">
                                        <label for="Status">Status</label>

                                        <select id="select-tamanho" name="status">

                                        <% if (produto.status === "visivel") { %>
                                            <option value="visivel" selected>visivel</option>

                                        <% } else {%>
                                            <option value="visivel">visivel</option>
                                        <% } %>
                                        <% if (produto.status=== "oculto") { %>
                                            <option value="oculto" selected>oculto</option>

                                         <% } else {%>
                                            <option value="oculto">oculto</option>

                                         <% } %>
                                         <% if (produto.status === "indisponivel") { %>
                                            <option value="indisponivel" selected>indisponivel</option>

                                         <% } else {%>
                                            <option value="indisponivel">indisponivel</option>

                                         <% } %>

                                        </select>
                                        

                                    </div>
                                    
                                    <div class="input-container">
                                        <input type="submit" class="submit" value=" Editar Produto ">

                    </form> 
                                    </div>
                                </div>

                                
                            </div>
                        </div>
                    </div>
                

                
            </div>
        </div>
    </div>
</body>
<script >

   var previewImage2 = document.getElementById('previewImage2');

    function fotoExemplo() {
        console.log('mensagem exibida');
        let limpar2 = document.getElementById('limpar_2')
        limpar2.style.display = 'none'

        console.log('func do eneerror ativada');
        let img2 = document.getElementById('previewImage2')
        img2.src = '/img/public/transferir.png'
        img2.src.marginBottom = '1px'
    }

previewImage2.addEventListener('error',  fotoExemplo)

        let inputFile = document.getElementById('foto');
        let previewImage = document.getElementById('fotoproduto');

        inputFile.addEventListener('change', function () {
            const file = this.files[0];

            if (file) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    previewImage.src = e.target.result;
                    previewImage.style.display = 'block';
                };

                reader.readAsDataURL(file);
            }
        });

        function input2() {
            var inputFile2 = document.getElementById('foto2');
            var previewImage2 = document.getElementById('previewImage2');
            var file = inputFile2.files[0];
            let limpar2 = document.getElementById('limpar_2')
            let foto2_existe = document.getElementById('foto2_existe')

            console.log('input 2 executado');
            
            if (file) {
                console.log('if executado');
                var reader = new FileReader();

                reader.onload = function (e) {
                    previewImage2.src = e.target.result;
                   

                    console.log('render executado');
                };
                previewImage2.style.display = 'inline';
                previewImage2.style.marginBottom = '-10px'
                reader.readAsDataURL(file);
                foto2_existe.value = 'false'

                console.log('data executado');
                limpar2.style.display = 'inline'

            }
        };

        document.getElementById('foto2').addEventListener('change', input2);


        function limpar() {
            
            var inputFile2 = document.getElementById('foto2');
            var previewImage2 = document.getElementById('previewImage2');
            let limpar2 = document.getElementById('limpar_2')
            let foto2_existe = document.getElementById('foto2_existe')

            inputFile2.value = '';
            previewImage2.src = '/img/public/transferir.png';
            previewImage2.style.marginBottom = '10px'
            limpar2.style.display = 'none'

            if (foto2_existe) {
                console.log('entrou no if de limpar');
                foto2_existe.value = 'false'
            }
            console.log(foto2_existe.value);

        }
function formatarInput(input) {
    console.log(input.value);
    let campoMonetario = input.value
    let formataValor = new Intl.NumberFormat('pt-BR', {style: 'currency', currency:'BRL'});
 
    let valorBruto = campoMonetario.replace(/\D/g, '');
    let valorFinal = (formataValor.format(parseFloat(valorBruto / 100)));
    input.value = valorFinal;

}
let v_input = document.getElementById("valor")
formatarInput(v_input)

        
</script>

</html>