                                                </label>
                                            <%#}%>

                                            
                                           
                                           
                                        </div>
                                        -->
                                    </div>
                                    
                                </div>
                                <div class="div1">
                                    <div class="input-container">
                                        <label for="nome">Nome</label>
                                        <input type="text" name="nome" id="nome" placeholder="Nome do Produto" value="<%= produto.nome_produto %>" required>
                                    </div>
                                    <div class="input-container">
                                        <label for="categoria">Marca</label>
                                        <input type="text" name="marca" id="marca"
                                            placeholder="Digite a marca" value="<%= produto.marca %>" required>
                                    </div>
                                    <div class="input-container">
                                        <label for="descricao">descrição</label>
                                        <input type="text" name="descricao" id="" placeholder="digite uma descricao para o produto" value="<%= produto.descricao %>">
                                        <label for="cor">Cor</label>
                                        <input type="text" name="cor" id="cor" placeholder="Digite a cor"  value="<%= produto.cor %>">
                                    </div>
                                    <div class="input-container">
                                        <label for="categoria">Categoria</label>
                                        <input type="text" name="categoria" id="categoria"
                                            placeholder="Digite a Categoria" required value="<%= produto.nome_categoria %>">
                                            <input type="hidden" name="id" value="<%= produto.id_produto %>">
                                    </div>
                                    <div class="input-container">
                                        <label for="valor">Valor</label>
                                        <input type="text"  id="valor" name="preco" step="0.01"
                                            placeholder="Digite o Valor"  value="<%= produto.preco %>">
                                    </div>
                                    <div class="input-container tamanho">
                                        <label for="Status">Status</label>

                                        <select id="select-tamanho" name="status">

                                        <% if (produto.status === "visivel") { %>
                                            <option value="visivel" selected>visivel</option>

                                        <% } else {%>
                                            <option value="visivel">visivel</option>
                                        <% } %>
