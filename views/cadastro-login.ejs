<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Entrar</title>
    <link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.0.2/css/bootstrap.min.css'>
    <link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css'>
       
    <link rel="stylesheet" href="/css/login/validacoes.css">
    <link rel="stylesheet" href="/css/home/style.css">
    <link rel="stylesheet" href="/css/login/cadastro.css"> 
    <link rel="stylesheet" href="/css/painel/style.css">

</head>

<body>

    <header class="painel-administrativo">
        <div class="logo">
            <img src="/logo/<%= empresa %>" alt="Logo da Loja">
        </div>
        <br>
        <nav style="margin-left: 28vw;">
            <ul class="opcoes">
                <% if (empresa == "administrador") { %>
                    <li class="opcao"><a class="link" href="/admin/usuarios">Usuarios</a></li>
               <% } %>
                <li class="opcao"><a class="link" href="/<%= empresa %>">Loja</a></li>
                <li class="opcao"><a class="link" href="/admin/produtos">Produtos</a></li>
                <li class="opcao"><a class="link" href="/admin/configuracoes">Configurações</a></li>
                <li class="opcao"><a class="link" href="/deslogar/<%= empresa %>">Sair </a></li>
            </ul>
        </nav>
        <br>
    </header>
    
    <div class="body">
    <div class="container" id="container">


        <div class="normal">
            <div class="form-container sign-up-container">
                <form action="/login/create" method="post">
                    <h1>Cadastre-se</h1>
                    
                    <div class="social-container">
                        <a href="#"  class="social"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"  class="social"><i class="fab fa-google"></i></a>
                        <a href="#"  class="social"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                    <span>Ou use seu e-mail para Cadastro</span>
                    <label>
                        <input type="text" placeholder="nome da empresa" name="nome"/>
                    </label>
                    <label>    
                    
                        <input type="email" placeholder="Seu email" name="email" id="inputEmail" required/>
                        <p id="validaEmail"></p>
                        

                    </label>
                    <label>
                        <input type="password" placeholder="Crie uma senha" name="senha" id="senha1" required/>
                    </label>
                    <label>
                        <input type="password" placeholder="Confirme a senha" id="senha2" required/>
                        <p class="aviso" id="aviso_igual"></p>
                    </label>
                    <button style="margin-top: 9px;" id="btn-cadastro">Próximo</button>
                    <br>
                    <!--<button class="ghost mobile" id="signIn-2">Entrar</button>-->
                    <span class="span-mobile">Tem uma Conta? <a class="a-mobile" id="signIn2" href="#"> Entrar</a></span>
                </form>
            </div>
        </div>
        <div class="normal">
            <div class="form-container sign-in-container">
                <form method="post" action="/authenticate">
                    <h1>Conecte-se!</h1>
                    
                    <span class="text-color">Ou faça login usando o endereço de e-mail</span>
                    <label>
                        <input type="email" placeholder="Digite seu email" name="email" id="email_login" required/>
                        <p class="aviso" id="aviso_login"></p>
                    </label>
                    <label>
                        <input type="password" placeholder="Digite sua senha" name="senha" id="senha_login" required/>
                        
                    </label>
                    <a href="#" class="a esqueceu">Esqueceu sua senha?</a>
                    <button id="btnLogin">Entrar</button>
                    <br>
                    <span class="span-mobile">Não tem uma Conta? <a class="a-mobile" id="signUp2" href="#"> Cadastre-se</a></span>
                </form>
            </div>
        </div>
        <div class="normal">
            <div class="overlay-container">
                <div class="overlay">
                    <div class="overlay-panel overlay-left">
                        <h1>Conecte-se!</h1>
                        <p>Faça login aqui se você já possui uma conta</p>
                        <button class="ghost" id="signIn">Entrar</button>
                    </div>
                    <div class="overlay-panel overlay-right">
                        <h1 >Criar uma conta!</h1>
                        <p>Cadastre-se se ainda não tiver uma conta</p>
                        <button class="ghost" id="signUp" >Cadastre-se</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    
    <script src='https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.2.3/js/bootstrap.min.js'></script>
    <script src="/js/login/validacoes.js"> </script>
    <script src="/js/login/script.js"></script>
</body>

</html>