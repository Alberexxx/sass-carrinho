<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/css/produtos/style.css">
    <link rel="stylesheet" href="/css/painel/style.css">

</head>
<head>
    <style> 
   body{
    background-color: rgb(233, 233, 233);
   }
 
</style>
<script>
  
</script>
</head>
<body>
 
    
     <header class="painel-administrativo">
            
            <nav >
                <ul class="opcoes">
                    <% if (empresa == "administrador") { %>
                        <li class="opcao"><a class="link" href="/admin/usuarios">Usuarios</a></li>
                   <% } %>
                    <li class="opcao"><a class="link" href="/<%= empresa %>">Loja</a></li>
                    <li class="opcao"><a class="link" href="/admin/produtos">Produtos</a></li>
                    <li class="opcao"><a class="link" href="/admin/configuracoes">Configurações</a></li>
                    <li class="opcao"><a class="link" href="/deslogar/<%= empresa %>">Sair</a></li>
                </ul>
            </nav>
        </header>

        <br><br>
   


         <p id="titulo">Produtos Cadastrados (<%= produtosCadastrados %>/<%= limite %>)</p>  <p id="msg-limite" style="display: inline;"></p> <br><br>
        <a style="color: black;" href="/admin/addProduto" id="linkAddProduto"> <button class="btn form"  id="btn_adicionar" style="display: block;">Adicionar Produtos</button></a>
        <br><br><br>

<table  id="tabela" border="2px"> 
    <thead >
        
        <tr>
        <th style="background-color: black;">Nº</th>
        <th style="background-color: black;" >NOME DO PRODUTO</th>

            <th style="background-color: black;" class="esconder">PREÇO</th>
            <th style="background-color: black;" class="esconder">status</th>
      
            
        <th style="background-color: black;">OPÇÔES DE PRODUTO</th>
        </tr>
    </thead>
    <body>
             <%  function limitarTamanhoString(str, limite) { %>
             <%   if (str.length > limite) { %>
             <%       return str.slice(0, limite) + "..."; %>
              <%  } else { %>
              <%      return str %>
              <%  } %>
         <%   } %>
    
        
        <% var cadastrados = produtosCadastrados +1 %>

       <% function formatarInput(input) { %>
    
        <%  let campoMonetario = input
            let formataValor = new Intl.NumberFormat('pt-BR', {style: 'currency', currency:'BRL'});
         
            let valorBruto = campoMonetario.replace(/\D/g, '');
            let valorFinal = (formataValor.format(parseFloat(valorBruto / 100)));
            return valorFinal; %>
        
      <% } %>
    <% produtos.forEach(produto => { %>
        <% cadastrados-- %>
            
            <tr> 
                <td><%= cadastrados %></td>
                <td ><%= limitarTamanhoString(produto.nome_produto,15) %></td>
               
                <td class="esconder"><%= formatarInput(produto.preco)%></td>
                <td class="esconder"><%= produto.status %></td>
                

                <td> 
                    <form action="/admin/editar-produto" method="post" style="display: inline;" id="excluir"> 
                        <input type="hidden" name="id" value="<%= produto.id_produto %>">
                        <input type="hidden" name="empresa" value="<%= empresa %>">
                        <button class="btn editar" type="button" onclick="confirmar(this.form, 'editar')"> Editar</button>

                    </form>
                    <form method="post" action="/admin/produtos/deletar" style="display: inline;">

                        <input type="hidden" name="id" value="<%= produto.id_produto %>">
                        <button class="btn btn-danger" type="button" onclick="confirmar(this.form, 'excluir')"> Deletar</button>

                    </form>
                        
                   
                       
                   
            </td>
    <% }) %>
    <br>
    
</table>
<br><br><br>
</body>
<script>
    
    function formatarInput(input) {
    
    let campoMonetario = input
    let formataValor = new Intl.NumberFormat('pt-BR', {style: 'currency', currency:'BRL'});
 
    let valorBruto = campoMonetario.replace(/\D/g, '');
    let valorFinal = (formataValor.format(parseFloat(valorBruto / 100)));
    return valorFinal;

}
    
    var cadastrados ='<%= produtosCadastrados %>'
    var limite_produtos = '<%= limite %>'
    
    var link = document.getElementById('linkAddProduto')
    var btn_adicionar = document.getElementById('btn_adicionar')
    var msg = document.getElementById('msg-limite')

    console.log(cadastrados)
    console.log( limite_produtos)
    if (parseInt(cadastrados) >= parseInt(limite_produtos)) {
        btn_adicionar.disabled = true
        btn_adicionar.style.backgroundColor = 'gray'
        link.href = ''
        msg.innerText = 'Limite de produtos atingido'
        msg.style.color = 'red'
    } 

    function confirmar(form, acao) {
        if (acao == 'excluir') {
            var confirmacao = confirm("Tem certeza que deseja excluir este produto?");
            if (confirmacao) {
                form.submit()
            } else {
                console.log("Exclusão cancelada pelo usuário.");

            }
        } else if (acao == 'editar') {
            form.submit()
        }
    }
  
    
</script>

</html>
