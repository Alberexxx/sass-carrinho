<!DOCTYPE html>
<html>

<head>
  <link rel="stylesheet" type="text/css" href="/css/abaCarrinho/styles.css">
</head>
<script src="/js/abaCarrinho/script.js"></script>

<body>


  <div class="main-content">

  </div>
  <div class="carrinhoMinimizado" id="miniaturaCarrinho"> 
    <img src="/img/carrinho/vista-lateral-vazia-do-carrinho-de-compras.png" alt="">
        <div class="notificacao_carrinho" id="notificacao_carrinho"></div>

  </div>
  <div class="cart-container" id="carrinho">

    <img src="/img/carrinho/x_resized.png" id="x_icon" alt="">
    
    <div class="cart-items">
      <!-- Aqui serão exibidos os itens do carrinho --> 
    </div>
   
   
    <div class="acoes">
      <div class="cart-actions">
        <button class="expand-cart-btn"> Expandir  <img src="/img/public/seta.png" alt="" id="icon_seta">
        </button>
        <button class="limpa_carrinho"  onclick="LimparCarrinho('<%= empresa %>')">Limpar Carrinho </button> <input type="hidden" id="isExpand_inp">
        <button class="btn-total" id="btn-total" ><strong>Total: </strong> R$0,00 </button>

      </div> 
      <button class="submit-btn" id="submit-btn" onclick="escolherPagamento('<%= empresa%>')">Finalizar Pedido</button>
    </div>
  </div>

  <div class="divPagamento" id="div_pagamento">
    <p>Escolha a forma de pagamento:</p> 

    <div class="botoes_pagamento">
    <% jsonString = JSON.stringify(taxas.taxas)
      %>
      <% if (taxas.taxas.avista.taxa == true) { %>
        <button onclick="escolherformaPag(1,'<%= jsonString %>')">À Vista/PIX</button>
      <% } %>
      <% if (taxas.taxas.credito.taxa == 'true') { %>
        <button onclick="escolherformaPag(2,'<%= jsonString %>')">Credito</button>
      <% } %>
      <% if (taxas.taxas.debito.taxa == 'true') { %>
        <button onclick="escolherformaPag(3,'<%= jsonString %>')">Debito</button>
      <% } %>
      <br>
    
  </div>
  <div class="div-btn-cancelar"> 
     <button class="btn-cancelar" onclick="esconderEscolha(1)">Cancelar</button>
     <button id="btn_pagamento_valor"></button>

</div>

  </div> 

  <div class="pag_avista" id="pag_avista">
    <p class="metd_name">Metodo de pagamento: À Vista/PIX</p>
    

    <div class="infos_pagamento">
    <p id="total_semDesconto_v"></p>
    <p id="desconto_v"></p>
    <p id="total_final_v"></p>
  </div>
    <input type="hidden" id="value_semDesconto_v">
    <input type="hidden" id="value_desconto_v">
    <input type="hidden" id="value_total_v">

    <div class="div-btn-cancelar">
    <button class="btn-voltar" onclick="esconderEscolha(2)">voltar</button>
    <button class="btn-enviar-wtsp" onclick="enviar('<%= empresa %>', 1, '<%= numero %>')"> enviar para o whatsApp</button>
  </div>
  </div>


<!--   --------------------------------------------------------------------------------------->
  <div class="pag_debito" id="pag_debito">
    <p class="metd_name"> Metodo de pagamento: Cartão de Debito </p>
    
  <div class="infos_pagamento">
    <p id="total_semDesconto_d"></p>
    <p id="desconto_d"></p>
    <p id="total_final_d"></p>
  </div>
  
    <input type="hidden" id="value_semDesconto_d">
    <input type="hidden" id="value_desconto_d">
    <input type="hidden" id="value_total_d">

  
    <div class="div-btn-cancelar">
    <button class="btn-voltar" onclick="esconderEscolha(3)">voltar</button>
    <button class="btn-enviar-wtsp" onclick="enviar('<%= empresa %>', 3, '<%= numero %>')">enviar para o whatsApp</button>
  </div>
  </div>

  <div class="pag_credito" id="pag_credito">
    <p class="metd_name">Metodo de pagamento: Cartão de Credito</p>

  <p class="texto_credito"> Como deseja parcelar a compra?</p>
    
    <div id="taxas_credito"><br></div>
    <br><br><br><br>

    <div class="div-btn-cancelar">
    <button class="btn-voltar" onclick="esconderEscolha(4)" id="btn_credito_voltar">voltar</button>
    <button class="btn-enviar-wtsp" onclick="enviar('<%= empresa %>', 2,'<%= numero %>')">enviar para o whatsApp</button>
  </div>
  </div>

</body>

<script src="/js/abaCarrinho/script2.js"></script>

</html>